test_setup { from together import create_client, client_chat, together_provider }
test "installed exports resolve" { c:=create_client({"api_key":"fixture","transport":func(url,o) { return Ok({"_status":200,"_body":"{\"choices\":[]}"}) }}); assert_true(client_chat(c,{})["ok"]); assert_equal(type(together_provider({})),"dict") }
